---
/**
 * RecipeJsonLd.astro
 *
 * Injects a schema.org/Recipe JSON-LD <script> into the page <head> via the
 * Layout named "head" slot.  All values come from locally-authored frontmatter
 * so set:html is safe here — there is no user-supplied input involved.
 */
import { formatIsoDuration, calculateTotalIsoDuration } from '../utils/duration.ts';

interface NutritionData {
	calories?: string;
	servingSize?: string;
	fatContent?: string;
	saturatedFatContent?: string;
	carbohydrateContent?: string;
	sugarContent?: string;
	fiberContent?: string;
	proteinContent?: string;
	sodiumContent?: string;
}

interface VideoData {
	name?: string;
	description?: string;
	thumbnailUrl?: string;
	uploadDate?: Date;
	contentUrl?: string;
	embedUrl?: string;
}

interface RatingData {
	ratingValue: number;
	reviewCount: number;
	bestRating?: number;
}

interface Props {
	name: string;
	description: string;
	category: string;
	course?: string;
	appliances?: string[];
	date: Date;
	prepTime?: string;
	cookTime?: string;
	servings?: number;
	cuisine?: string;
	ingredients?: string[];
	instructions?: string[];
	imageUrl?: string;
	tags?: string[];
	recipeUrl?: string;
	stepImages?: (string | undefined)[];
	nutrition?: NutritionData;
	video?: VideoData;
	rating?: RatingData;
}

const {
	name,
	description,
	category,
	course,
	appliances,
	date,
	prepTime,
	cookTime,
	servings,
	cuisine,
	ingredients,
	instructions,
	imageUrl,
	tags,
	recipeUrl,
	stepImages,
	nutrition,
	video,
	rating,
} = Astro.props;

const courseLabels: Record<string, string> = {
	main: 'Main Course',
	side: 'Side Dish',
	dessert: 'Dessert',
	beverage: 'Beverage',
	sauce: 'Sauce & Seasoning',
	other: 'Other',
};

const applianceLabels: Record<string, string> = {
	'slow-cooker': 'Slow Cooker',
	'dutch-oven': 'Dutch Oven',
	'instant-pot': 'Pressure Cooker',
	'ninja-creami': 'Ninja Creami',
};

// Build the JSON-LD object, omitting keys whose values are absent so that
// Google's Rich Results Test does not flag empty/null fields.
const ld: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'Recipe',
	name,
	description,
	author: { '@type': 'Person', name: 'Sybil Melton' },
	datePublished: date.toISOString().slice(0, 10),
	recipeCategory: course ? (courseLabels[course] ?? course) : category,
};

if (appliances && appliances.length > 0) {
	ld.cookingMethod = appliances.map((a) => applianceLabels[a] ?? a);
}

if (imageUrl) ld.image = [imageUrl];

// Format prepTime, cookTime, and totalTime into ISO 8601 durations (e.g. "PT20M")
// to meet Google's Rich Results specifications.
const isoPrep = formatIsoDuration(prepTime);
const isoCook = formatIsoDuration(cookTime);
const isoTotal = calculateTotalIsoDuration(prepTime, cookTime);

if (isoPrep) ld.prepTime = isoPrep;
if (isoCook) ld.cookTime = isoCook;
if (isoTotal) ld.totalTime = isoTotal;

if (servings) ld.recipeYield = `${servings} servings`;
if (cuisine) ld.recipeCuisine = cuisine;

// Map tags, category, and cuisine to comma-separated keywords
const keywordSet = new Set<string>();
if (tags && tags.length > 0) {
	tags.forEach((t) => keywordSet.add(t));
}
if (cuisine) keywordSet.add(cuisine);
if (course && courseLabels[course]) keywordSet.add(courseLabels[course]);
if (keywordSet.size > 0) {
	ld.keywords = Array.from(keywordSet).join(', ');
}

if (ingredients && ingredients.length > 0) ld.recipeIngredient = ingredients;

// Format recipeInstructions as structured HowToStep objects with name, text, url, and optional image
if (instructions && instructions.length > 0) {
	ld.recipeInstructions = instructions.map((instruction, index) => {
		let stepName = `Step ${index + 1}`;
		let stepText = instruction.trim();

		const colonIndex = instruction.indexOf(':');
		// If colon exists within first 60 characters, treat prefix as step title
		if (colonIndex > 0 && colonIndex < 60) {
			const potentialTitle = instruction.slice(0, colonIndex).trim();
			const cleanedTitle = potentialTitle.replace(/^(?:step\s*\d+\s*[:.-]?\s*|\d+\s*[:.-]?\s*)/i, '').trim();
			if (cleanedTitle.length > 0) {
				stepName = cleanedTitle;
			}
			stepText = instruction.slice(colonIndex + 1).trim();
		}

		const step: Record<string, unknown> = {
			'@type': 'HowToStep',
			name: stepName,
			text: stepText || instruction.trim(),
		};

		if (recipeUrl) {
			step.url = `${recipeUrl}#step-${index + 1}`;
		}

		const stepImg = stepImages?.[index];
		if (stepImg) {
			step.image = stepImg;
		}

		return step;
	});
}

// Nutrition information (optional)
if (nutrition) {
	const nutObj: Record<string, unknown> = {
		'@type': 'NutritionInformation',
	};
	for (const [key, val] of Object.entries(nutrition)) {
		if (val) nutObj[key] = val;
	}
	if (Object.keys(nutObj).length > 1) {
		ld.nutrition = nutObj;
	}
}

// Video information (optional)
if (video) {
	const vidObj: Record<string, unknown> = {
		'@type': 'VideoObject',
		name: video.name ?? name,
		description: video.description ?? description,
	};
	if (video.thumbnailUrl) vidObj.thumbnailUrl = [video.thumbnailUrl];
	else if (imageUrl) vidObj.thumbnailUrl = [imageUrl];
	if (video.uploadDate) vidObj.uploadDate = video.uploadDate.toISOString().slice(0, 10);
	if (video.contentUrl) vidObj.contentUrl = video.contentUrl;
	if (video.embedUrl) vidObj.embedUrl = video.embedUrl;
	ld.video = vidObj;
}

// Aggregate rating (optional, only when genuine rating data is available)
if (rating && rating.reviewCount > 0) {
	ld.aggregateRating = {
		'@type': 'AggregateRating',
		ratingValue: rating.ratingValue,
		reviewCount: rating.reviewCount,
		bestRating: rating.bestRating ?? 5,
	};
}

// Safely serialize JSON for inline embedding in a <script> tag.
// Replacing < > & prevents </script> or <!-- sequences in string values from
// breaking out of the script element — matching what Next.js and other
// frameworks do for embedded JSON-LD.
const ldJson = JSON.stringify(ld)
	.replace(/</g, '\\u003c')
	.replace(/>/g, '\\u003e')
	.replace(/&/g, '\\u0026');
---

<script type="application/ld+json" set:html={ldJson} />
