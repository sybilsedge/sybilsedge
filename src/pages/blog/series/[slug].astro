---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { getReadingTime } from '../../../utils/readingTime.ts';

export const prerender = true;

export async function getStaticPaths() {
	const seriesEntries = await getCollection('series');
	return seriesEntries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Collect all posts that belong to this series, sorted by seriesOrder then date
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const seriesPosts = allPosts
	.filter((p) => p.data.series === entry.id)
	.sort((a, b) => {
		const orderDiff = (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999);
		return orderDiff !== 0 ? orderDiff : a.data.date.valueOf() - b.data.date.valueOf();
	});

const arrowSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`;
const backSvg  = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>`;
const clockSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`;
---

<Layout
	title={`${entry.data.title} | Series | Sybilsedge`}
	description={entry.data.description}
	ogImage="/og/default.png"
>
	<div class="mx-auto w-full max-w-[960px] px-4 py-6 md:px-8 md:py-10">

		<!-- Back link -->
		<a
			href="/blog"
			class="mb-6 inline-flex items-center gap-2 font-tech text-[11px] uppercase tracking-[0.16em] text-cyan-300/50 hover:text-cyan-300 transition-colors"
		>
			<span set:html={backSvg} />
			All Posts
		</a>

		<!-- Series header -->
		<header class="mb-8 rounded-md blueprint-border bg-black/35 p-6 md:p-8">
			<p class="font-tech text-[11px] uppercase tracking-[0.22em] text-cyan-300/50">// Series</p>
			<h1 class="font-orbitron mt-2 text-2xl uppercase tracking-[0.1em] text-cyan-100 md:text-3xl">
				{entry.data.title}
			</h1>
			<p class="mt-4 text-base leading-relaxed text-slate-300/85 max-w-2xl">
				{entry.data.description}
			</p>
			{entry.data.tags.length > 0 && (
				<div class="mt-4 flex flex-wrap gap-1.5">
					{entry.data.tags.map((tag) => (
						<span class="rounded font-tech text-[10px] uppercase tracking-[0.1em] px-2 py-0.5 bg-black/40 border border-cyan-300/10 text-cyan-300/45">
							{tag}
						</span>
					))}
				</div>
			)}
			<!-- Optional extended prose from the MDX body -->
			<div class="mt-6 text-sm leading-relaxed text-slate-300/70 prose-series">
				<Content />
			</div>
		</header>

		<!-- Post list -->
		<section aria-labelledby="series-posts-heading">
			<h2
				id="series-posts-heading"
				class="font-tech text-[10px] uppercase tracking-[0.22em] text-cyan-300/50 mb-4"
			>
				// {seriesPosts.length} {seriesPosts.length === 1 ? 'Post' : 'Posts'} in this Series
			</h2>

			{seriesPosts.length === 0 ? (
				<div class="blueprint-border rounded-md bg-black/35 p-8 text-center">
					<p class="font-tech text-[11px] text-cyan-300/40 uppercase tracking-[0.16em]">Posts coming soon</p>
				</div>
			) : (
				<ol class="space-y-4" role="list">
					{seriesPosts.map((post) => {
						const partNum = post.data.seriesOrder;
						const formattedDate = post.data.date.toLocaleDateString('en-US', {
							year: 'numeric',
							month: 'short',
							day: 'numeric',
						});
						const readingTime = getReadingTime(post.body ?? '');
						return (
							<li>
								<a
									href={`/blog/${post.id}`}
									class="series-post-card group flex items-start gap-5 blueprint-border rounded-md bg-black/35 p-5 md:p-6 transition-all duration-150 hover:bg-black/50 hover:scale-[1.005]"
								>
									<!-- Part number badge -->
									<div class="shrink-0 w-9 h-9 rounded-md border border-cyan-300/20 bg-cyan-300/[0.06] flex items-center justify-center mt-0.5">
										<span class="font-orbitron text-xs font-bold text-cyan-300/60">
											{partNum ?? '·'}
										</span>
									</div>

									<!-- Content -->
									<div class="flex flex-col gap-1.5 flex-1 min-w-0">
										<p class="font-orbitron text-sm uppercase tracking-[0.08em] text-cyan-100 leading-snug group-hover:text-white transition-colors">
											{post.data.title}
										</p>
										<div class="flex items-center gap-2 font-tech text-[10px] text-cyan-300/35">
											<time datetime={post.data.date.toISOString()}>{formattedDate}</time>
											<span aria-hidden="true">·</span>
											<span class="flex items-center gap-1">
												<span set:html={clockSvg} />
												{readingTime}
											</span>
										</div>
										<p class="text-sm leading-relaxed text-slate-300/75 mt-1">
											{post.data.description}
										</p>
									</div>

									<!-- Arrow -->
									<span set:html={arrowSvg} class="shrink-0 text-cyan-300/30 group-hover:text-cyan-300/70 transition-colors mt-1" />
								</a>
							</li>
						);
					})}
				</ol>
			)}
		</section>
	</div>

	<style>
		.prose-series :global(p) {
			font-size: 0.9rem;
			color: rgb(148 163 184 / 0.7);
			line-height: 1.7;
		}
	</style>
</Layout>
